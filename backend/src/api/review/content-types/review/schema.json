{
  "kind": "collectionType",
  "collectionName": "reviews",
  "info": {
    "singularName": "review",
    "pluralName": "reviews",
    "displayName": "Review",
    "description": "Reviews for workouts"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "rating": {
      "type": "integer",
      "required": true,
      "min": 1,
      "max": 5
    },
    "content": {
      "type": "text",
      "required": true
    },
    "helpful": {
      "type": "integer",
      "default": 0
    },
    "workout": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::workout.workout"
    }
  }
}
